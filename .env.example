# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true to force demo checkout even if Stripe key exists
DEMO_MODE=true

# Stripe (required for real charges)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI (optional — demo generator works without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Email delivery (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meridian Briefs <onboarding@resend.dev>
OWNER_EMAIL=

# Owner inbox
OWNER_PASSWORD=meridian-owner
